# Which published version of the sibling packages the manual loads.
#
# Used two ways, both from these names: `%VITE_…%` inside the HTML templates,
# and `window.__hanCdn` which _layout.html injects for public/home/codegen.js
# — that file is served verbatim out of public/, so Vite never sees it and it
# cannot read import.meta.env.
#
# To soak-test a release candidate without committing a version bump, put the
# overrides in `.env.local` (git-ignored) instead of editing this file:
#
#     VITE_DIANTENJEOM_VERSION=0.2.0-rc.1
#     VITE_ZIANO_VERSION=0.2.0-rc.1
#
# Two variables rather than one: the packages are versioned independently and
# nothing guarantees they stay in step.

VITE_DIANTENJEOM_VERSION=0.2.0-rc.0
VITE_ZIANO_VERSION=0.2.0-rc.0
