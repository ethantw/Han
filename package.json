{
  "name": "@hanzi.pro/han.css",
  "version": "4.0.0-rc.1",
  "description": "A CSS typography set curated for CJK web pages.",
  "type": "module",
  "main": "./dist/han.js",
  "types": "./dist/types/han.d.ts",
  "style": "./dist/han.css",
  "exports": {
    ".": {
      "types": "./dist/types/han.d.ts",
      "browser": "./dist/han.browser.js",
      "import": "./dist/han.js",
      "default": "./dist/han.js"
    },
    "./auto": {
      "types": "./dist/types/han.auto.d.ts",
      "browser": "./dist/han.auto.browser.js",
      "import": "./dist/han.auto.js",
      "default": "./dist/han.auto.js"
    },
    "./styles": "./dist/han.css",
    "./styles/semantics": "./dist/han.semantics.css",
    "./styles/lines": "./dist/han.lines.css",
    "./styles/prose": "./dist/han.prose.css",
    "./styles/fonts": "./dist/han.fonts.css",
    "./basic-styles": "./dist/han.basic.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "README.zh-Hant.md",
    "README.ja.md",
    "README.ko.md",
    "LICENSE",
    "LICENSE-FONTS"
  ],
  "scripts": {
    "build": "node ./build/library",
    "dev": "node ./build/library --watch",
    "start": "pnpm -r --parallel --include-workspace-root run dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/ts/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/ts/**' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 'src/ts/**/*.test.ts'",
    "serve": "node build/serve.js",
    "pretest:e2e": "node build/library && pnpm --filter han-manual build",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "keywords": [
    "han",
    "css",
    "typography",
    "hanzi",
    "kanji",
    "hanja",
    "normalize"
  ],
  "author": "Chen Yijun (ethantw@me.com)",
  "homepage": "https://hanzi.pro",
  "bugs": "https://github.com/ethantw/Han/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethantw/Han.git"
  },
  "license": "MIT",
  "dependencies": {
    "hyperly": "0.2.0-rc.3"
  },
  "optionalDependencies": {
    "happy-dom": "^20.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "typescript": "^6.0.3"
  }
}
