.DS_Store
.sass-cache/
.ideas/
node_modules/
dist/
playwright-report/
test-results/
packages/fonts/
.claude/settings.local.json
# Re-include docs/ — the user's global ~/.gitignore_global excludes it, and
# this repo ignored it locally too, so durable notes stayed invisible until
# someone remembered `git add -f`. Scratch belongs in .ideas/, not here.
!/docs/
.commit-script.sh
.superpowers/

# Python bytecode (gen_partials.py etc.)
__pycache__/
*.pyc

# ad-hoc measurement / screenshot scripts run from the repo root (Playwright
# can't resolve @playwright/test from the scratchpad, so probes get copied here)
/.*.mjs

# computed-style snapshots (manual/tests/computed-baseline.mjs) — a working
# artefact of a refactor, meaningless once it lands
manual/tests/.baseline/
